# 密钥中心控制台 · 环境变量样例（复制为 .env.local，不要提交真实值）
#
# 默认（不设任何变量）= 演示：占位数据 + 演示会话，无需后端、无需登录。

# ---- 数据源：mock（默认）| api ----
VITE_DATA_MODE=mock
# VITE_DATA_MODE=api
# 管理面基址；默认同源 /bff（生产由 vercel.ts rewrites 代理到 api.autional.com / .cn）
# VITE_API_BASE=/bff/secret/api/v1/admin/secrets
# 租户/应用兜底（JWT 已带 tenant_id / app_id 时以令牌为准）
# VITE_TENANT_ID=
# VITE_APP_ID=

# ---- 鉴权：mock（默认）| oidc ----
VITE_AUTH_MODE=mock
# VITE_AUTH_MODE=oidc
# VITE_REQUIRE_AUTH=1
# VITE_OIDC_AUTHORIZE=https://auth.autional.com/oauth/api/v1/oauth/authorize
# VITE_OIDC_TOKEN=/bff/oauth/api/v1/oauth/token
# VITE_OIDC_CLIENT_ID=client-xxxxxxxx
# VITE_OIDC_REDIRECT_URI=https://secret.autional.com/oauth/callback
# VITE_OIDC_SCOPE=openid profile email

# ---- 其他 ----
# 「返回平台」链接（默认按访问域名推导 platform.autional.com / platform.autional.cn）
# VITE_PLATFORM_URL=https://platform.autional.com
