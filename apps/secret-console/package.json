{
  "name": "@autional/secret-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "密钥中心控制台（密钥列表 / 审计）",
  "scripts": {
    "dev": "vite --port 13122",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 13122",
    "typecheck": "tsc --noEmit",
    "lint:a11y": "eslint -c eslint.a11y.config.mjs --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@autional/shared": "0.1.0-rc.67",
    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.18",
    "@autional/ui": "0.1.0-rc.56",
    "antd": "6.5.0",
    "dayjs": "1.11.23",
    "i18next": "26.0.10",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "0.509.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-i18next": "17.0.7",
    "react-router": "7.15.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.4.0",
    "autoprefixer": "10.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.4",
    "@playwright/test": "^1.65.0",
    "vitest": "3.2.0"
  }
}
