# 密钥中心控制台 · 环境变量样例（复制为 .env.local，不要提交真实值）
#
# 默认（不设任何变量）= 演示：占位数据 + 演示会话，无需后端、无需登录。

# ---- 数据源：mock（默认）| api ----
VITE_DATA_MODE=mock
# VITE_DATA_MODE=api
# 管理面基址；默认同源 /bff（生产由 vercel.ts rewrites 代理到 api.autional.com / .cn）
# VITE_API_BASE=/bff/secret/api/v1/admin/secrets
# 审计查询基址（独立服务）
# VITE_AUDIT_BASE=/bff/audit/api/v1/admin/audit
# 租户服务管理面（门户目录）
# VITE_TENANT_BASE=/bff/tenant/api/v1/admin

# 密钥服务 X-Namespace：必须 ∈ 实例 SECRET_NAMESPACES，否则 400（fail-closed）。
# 该维度不分区数据（只做门禁）。生产栈 = prod，本地/开发栈 = dev。
# VITE_API_NAMESPACE=prod

# 租户/应用兜底（登录会话已带 tenant_id / app_id 时以令牌为准；
# 运行期可在页面顶栏切换数据作用域，不写死）
# VITE_TENANT_ID=
# VITE_APP_ID=

# ---- 鉴权：mock（默认）| oidc ----
VITE_AUTH_MODE=mock
# VITE_AUTH_MODE=oidc
# VITE_REQUIRE_AUTH=1
# VITE_OIDC_AUTHORIZE=https://auth.autional.com/oauth/api/v1/oauth/authorize
# VITE_OIDC_TOKEN=/bff/oauth/api/v1/oauth/token
# VITE_OIDC_CLIENT_ID=client-xxxxxxxx
# VITE_OIDC_REDIRECT_URI=https://secret.autional.com/oauth/callback
# 必须含 read（读接口 enforce）与 offline_access（refresh_token）
# VITE_OIDC_SCOPE=openid profile email offline_access read

# ---- 其他 ----
# 「返回平台」链接（默认按访问域名推导 platform.autional.com / platform.autional.cn）
# VITE_PLATFORM_URL=https://platform.autional.com
