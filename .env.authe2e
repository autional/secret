# 认证流程 e2e 专用（`playwright.auth.config.ts`，`vite --mode authe2e`）。
#
# 为什么单独一份：仓库根的 `.env.local` 会盖掉 `webServer.env`（Vite 里 `.env.[mode]`
# 优先级高于进程环境变量），所以只能用 `--mode authe2e` 让 mode 专属文件生效。
#
# 无任何密钥：IdP 是本地 `e2e/support/fake-oidc.mjs`，数据走 mock。
VITE_DATA_MODE=mock
VITE_REQUIRE_AUTH=1
VITE_AUTH_MODE=oidc
VITE_OIDC_CLIENT_ID=test-client
VITE_OIDC_AUTHORIZE=http://127.0.0.1:13931/authorize
VITE_OIDC_TOKEN=http://127.0.0.1:13931/token
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:13924/oauth/callback
VITE_OIDC_SCOPE=openid profile email offline_access read
